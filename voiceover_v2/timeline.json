   "next": 5.335940000000001,
   "text": "One messy spreadsheet."
  },
  {
   "start": 5.43594,
   "end": 6.660290000000001,
   "next": 7.160290000000002,
   "text": "And it's still just a hunch."
  },
  {
   "start": 7.260290000000001,
   "end": 7.911689999999999,
   "next": 9.460290000000002,
   "text": "Meet Signal Dart."
  },
  {
   "start": 9.560290000000002,
   "end": 12.003590000000003,
   "next": 12.503590000000003,
   "text": "Validate the idea. Then watch the market. All in one place."
  },
  {
   "start": 12.603590000000002,
   "end": 14.045390000000005,
   "next": 14.545390000000005,
   "text": "Just describe your idea in one sentence."
  },
  {
   "start": 14.645390000000004,
   "end": 19.41169,
   "next": 19.911690000000007,
   "text": "Signal Dart finds your competitors, reads their pricing pages, and measures real search demand, all on its own."
  },
  {
   "start": 20.01169000000001,
   "end": 25.186790000000006,
   "next": 25.68679000000001,
   "text": "In minutes, your market is mapped. Competitors, features, search demand, and a clear opportunity score."
  },
  {
   "start": 25.78679000000001,
   "end": 28.90259000000001,
   "next": 29.40259000000001,
   "text": "These are your real competitors, with live data on every single one."
  },
  {
   "start": 29.502590000000012,
   "end": 33.46549000000001,
   "next": 33.96549000000001,
   "text": "Funding, pricing, reviews, even who they're hiring. All in one view."
  },
  {
   "start": 34.06549000000001,
   "end": 38.30069000000001,
   "next": 38.80069000000001,
   "text": "Every feature, verified. Signal Dart checks each one against the competitor's own website."
  },
  {
   "start": 38.90069000000001,
   "end": 42.03439000000001,
   "next": 42.53439000000001,
   "text": "So you can spot the features buyers want, that almost nobody offers."
  },
  {
   "start": 42.63439000000001,
   "end": 47.49979000000001,
   "next": 47.99979000000001,
   "text": "Find the demand they missed. See what real buyers search for every month, and the keywords nobody ranks for yet."
  },
  {
   "start": 48.09979000000001,
   "end": 54.70879,
   "next": 55.20879,
   "text": "Spot the gap, and price it right. Uncover the pain points customers complain about, and see exactly where your price lands against every rival."
  },
  {
   "start": 55.30879,
   "end": 56.78489,
   "next": 57.80879,
   "text": "Research it once. Then watch it."
  },
  {
   "start": 57.90879,
   "end": 62.80949,
   "next": 63.30949,
   "text": "When a rival cuts prices, ships a new feature, raises money, or starts hiring, you hear about it first."
  },
  {
   "start": 63.40949,
   "end": 64.52919,
   "next": 65.02918999999999,
   "text": "And nothing here is invented."
  },
  {
   "start": 65.12918999999998,
   "end": 68.05798999999998,
   "next": 68.55798999999996,
   "text": "Every single figure links straight back to the page it came from."
  },
  {
   "start": 68.65798999999996,
   "end": 77.24118999999996,
   "next": 77.74118999999997,
   "text": "Six powerful engines. Competitor research, SEO intelligence, market gap analysis, an AI strategy advisor, autonomous monitoring, and executive reports."
  },
  {
   "start": 77.84118999999997,
   "end": 81.39468999999997,
   "next": 81.89468999999997,
   "text": "One clear answer. Export it to PDF, PowerPoint, or Notion."
  },
  {
   "start": 81.99468999999996,
   "end": 83.90768999999996,
   "next": 84.40768999999996,
   "text": "Validate the idea. Then watch the market."
  },
